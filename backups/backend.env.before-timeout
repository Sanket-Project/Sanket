# ── Database ────────────────────────────────────────────────────────────────
# !! REPLACE with your actual DSN. Never commit real credentials.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://sanket_app:changeme@localhost:5432/sanket_recovered_20261026

# ── Redis (rate limiting, WebSocket fan-out, arq job queue) ──────────────────
# Local dev: run `docker compose up -d redis` to provide this.
REDIS_URL=redis://localhost:6379/0

# Pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
# !! NEVER use this placeholder value in production.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32-min-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── ML inference service (service-to-service auth) ────────────────────────────
# Must match the ml-api's ML_SERVICE_TOKEN. The docker ml-api derives its token
# from the root .env JWT_SECRET, so when running the native backend (start-dev.bat)
# against the dockerized ml-api, pin the same value here or every /forecasts call
# fails with 401→502. Keep this in sync with root .env JWT_SECRET.
ML_SERVICE_TOKEN=fbc2b8b3347ccc11660eb9dbbd970c1c442f54276322acbda861c2ca941922ad
ML_API_URL=http://127.0.0.1:8001

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_NAME=SANKET
APP_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ── Security ─────────────────────────────────────────────────────────────────
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Optional: TimescaleDB hypertable conversion ───────────────────────────────
TIMESCALEDB_ENABLED=false

# ── Optional: External signal sources ────────────────────────────────────────
GOOGLE_TRENDS_API_KEY=
WEATHER_API_KEY=

# ── Firebase Authentication ──────────────────────────────────────────────────
# Set FIREBASE_PROJECT_ID to enable Firebase auth; leave blank for dev-login fallback.
FIREBASE_PROJECT_ID=
# OPTION A: Path to a service-account JSON file (local dev only — never commit this file)
FIREBASE_CREDENTIALS_PATH=
# OPTION B (preferred for production/Cloud Run): base64-encoded service-account JSON
# Generate: base64 -w0 path/to/firebase-credentials.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_WEB_API_KEY=

